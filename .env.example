# Never put a real value in this file: it is committed, and the repo is public. Real values go in .env (ignored).


# MongoDB Atlas hackathon sandbox
MONGODB_URI=
MONGODB_DB=gomon

# Embeddings (Voyage AI)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Voice (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# Meeting bot (Recall.ai)
RECALL_API_KEY=
RECALL_REGION=us-west-2

# Public https URL for the bot page and webhooks (a tunnel to BOT_PAGE_PORT)
PUBLIC_BASE_URL=

# Bot page server (apps/bot-page)
BOT_PAGE_PORT=8787
# Worker the bot page talks to: utterances in, says stream out (WORKER_TOKEN below is sent as a bearer token).
# Set WORKER_URL= (empty) to turn the says bridge off when testing with `npm run sink`.
WORKER_URL=http://localhost:3001
UTTERANCE_API_URL=http://localhost:3001/api/utterances
# Recall workspace verification secret (dashboard: Developers > API Keys & Secrets). Preferred over the token.
RECALL_WEBHOOK_SECRET=
RECALL_WEBHOOK_TOKEN=
RECALL_BOT_VARIANT=web_4_core
SAY_TOKEN=
SAY_ACK_URL=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Light format: the Recall bot outputs 16 kHz mono, so this loses nothing in the Meet and starts sooner
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
# Lines to generate at startup so they play with no ElevenLabs wait, separated by "|" (e.g. On it.|One moment.)
SAY_PRECACHE=

# LLM (no sponsor credits; bring one key)
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gomon

# Integrations
GITHUB_TOKEN=
GITHUB_REPO=WagerWarrior/MongoDB
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0CHU319A2V

# Demo scope
TEAM_ID=northwind-platform
PROJECT_ID=public-api-launch

# Worker (apps/worker): utterances in, says out (SSE), consensus locks, memory governance
WORKER_PORT=3001
WORKER_TOKEN=
VETO_MS=10000
ANALYZE_MODEL=claude-sonnet-5-5
# VOICE_OUT=recall: the worker speaks into the meeting itself (ElevenLabs mp3 -> Recall output_audio); create bots with `npm run join`.
# Leave empty when the bot page (Output Media) plays speech.
VOICE_OUT=
VOICE_MODEL=eleven_flash_v2_5
EMBED_MODEL=voyage-4
LANGSMITH_TRACING=true
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=

# Answer trace: after each answer Gomon posts one line in the Meet chat (what it searched, hits, seconds). "off" disables it.
CHAT_TRACE=
